# For Vercel Settings > Environment Variables, or local `vercel dev`.
# Never commit real keys/passcodes into the repository or frontend code.
OPENAI_API_KEY=your_server_only_api_key_here
SPECX_PREVIEW_PASSCODE=choose_a_long_private_owner_passcode
# Optional, default: gpt-image-2.5-flare
SPECX_IMAGE_MODEL=gpt-image-2.5-flare
